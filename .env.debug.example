# 本地 12 入口 debug（与生产同一套 create_service_app，只换资源）。
#
#   cp .env.debug.example .env.debug
#   Windows:  powershell -ExecutionPolicy Bypass -File scripts\serve-local.ps1
#   或 Cursor 调试 AuraClaw: serve (local)
#
# 存储 / 事件 / 制品 / Vault / Redis / 价格洞察与 .env.dev 共用 10.244.* 实验室中间件。
# 10.244.* 不通时对应依赖会连不上。模型仍用本文件的 MaaS；Java MCP 仍需 Admin 登记。

AURACLAW_DEPLOYMENT_PROFILE=development
AURACLAW_LOG_LEVEL=DEBUG
AURACLAW_HOST=127.0.0.1
AURACLAW_ALLOW_INSECURE_IDENTITY_HEADERS=true
AURACLAW_CORS_ALLOW_ORIGINS=http://10.244.16.130:3000,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:1420,http://localhost:1420

AURACLAW_STORAGE_BACKEND=kingbase
AURACLAW_RUNTIME_EVENT_BACKEND=kafka
AURACLAW_ARTIFACT_BACKEND=seaweedfs
AURACLAW_WORKER_WAKE_ENABLED=true
AURACLAW_RUNTIME_ENABLED=true
AURACLAW_RUNTIME_ROLE=agent
AURACLAW_RUNTIME_ID=runtime-local-1
AURACLAW_RUNTIME_NODE_ID=local
AURACLAW_RUNTIME_CAPACITY=1

AURACLAW_LEASE_SIGNING_KEY=auraclaw-local-debug-lease-signing-key
AURACLAW_TASK_API_WORKLOAD_TOKEN=local-task-api
AURACLAW_PROJECTION_WORKLOAD_TOKEN=local-projection
AURACLAW_ORCHESTRATOR_WORKLOAD_TOKEN=local-orchestrator
AURACLAW_RUNTIME_WORKLOAD_TOKEN=local-runtime
AURACLAW_MODEL_GATEWAY_WORKLOAD_TOKEN=local-model-gateway
AURACLAW_ACTION_HANDS_WORKLOAD_TOKEN=local-action-hands
AURACLAW_POLICY_WORKLOAD_TOKEN=local-policy
AURACLAW_CREDENTIAL_PROXY_WORKLOAD_TOKEN=local-credential-proxy
AURACLAW_ARTIFACT_SERVICE_WORKLOAD_TOKEN=local-artifact-service
AURACLAW_DELIVERY_WORKLOAD_TOKEN=local-delivery
AURACLAW_STREAMING_GATEWAY_WORKLOAD_TOKEN=local-streaming-gateway

# Java 智问代理应指向统一入口 8080，不要直连 Task API 8000。
# auraclaw serve 会在 8080 分流：/v1/streams/* → 8010，其余 → 8000。
AURACLAW_INGRESS_ENABLED=true
AURACLAW_INGRESS_PORT=8080
AURACLAW_TASK_API_PORT=8000
AURACLAW_SESSION_PORT=8001
AURACLAW_PROJECTION_PORT=8002
AURACLAW_ORCHESTRATOR_PORT=8003
AURACLAW_RUNTIME_PORT=8004
AURACLAW_MODEL_GATEWAY_PORT=8005
AURACLAW_HANDS_PORT=8006
AURACLAW_POLICY_PORT=8007
AURACLAW_CREDENTIAL_PROXY_PORT=8008
AURACLAW_ARTIFACT_PORT=8009
AURACLAW_STREAMING_PORT=8010
AURACLAW_DELIVERY_PORT=8011

AURACLAW_SESSION_BASE_URL=http://127.0.0.1:8001
AURACLAW_PROJECTION_BASE_URL=http://127.0.0.1:8002
AURACLAW_CONTROL_BASE_URL=http://127.0.0.1:8003
AURACLAW_RUNTIME_BASE_URL=http://127.0.0.1:8004
AURACLAW_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8005
AURACLAW_HANDS_URL=http://127.0.0.1:8006
AURACLAW_POLICY_BASE_URL=http://127.0.0.1:8007
AURACLAW_CREDENTIAL_PROXY_BASE_URL=http://127.0.0.1:8008
AURACLAW_ARTIFACT_BASE_URL=http://127.0.0.1:8009
AURACLAW_DELIVERY_BASE_URL=http://127.0.0.1:8011

# 可选：OpenAI 兼容端点。留空时 12 个入口仍可启动。
AURACLAW_MODEL_PROVIDER=openai_compatible
AURACLAW_MODEL_TIMEOUT_SECONDS=120
AURACLAW_DEVELOPMENT_MODEL_MODE=provider

AURACLAW_MODEL_API_KEY=sk-6c26be75bb55406481f2bd593900edc9
AURACLAW_MODEL_BASE_URL=https://api.deepseek.com
AURACLAW_MODEL_NAME=deepseek-v4-pro

# --- Kafka（与 .env.dev 相同）---
KAFKA_HOST=10.244.16.132
KAFKA_PORT=9092
AURACLAW_KAFKA_RUNTIME_TOPIC=managed-agent.runtime-events
AURACLAW_KAFKA_STREAMING_GROUP=streaming-ingestor
AURACLAW_RUNTIME_EVENT_RETENTION_EVENTS=1000
AURACLAW_STREAM_CONNECTION_QUEUE_SIZE=128

# --- SeaweedFS / Artifact（与 .env.dev 相同）---
SEAWEEDFS_HOST=10.244.16.132
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ACCESS_KEY=5542e08e29388053bca2334e8cf5238aad9ae2cb
SEAWEEDFS_SECRET_KEY=2d6080289003806ef109d7212732e29546f7ef550ebd1579840a2e4f7ecd56e9
SEAWEEDFS_BUCKET=auraclaw-artifacts
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_USE_SSL=false
SEAWEEDFS_PATH_STYLE=true
AURACLAW_ARTIFACT_ROOT=.data/artifacts
AURACLAW_ARTIFACT_MULTIPART_THRESHOLD=16777216
AURACLAW_ARTIFACT_MULTIPART_PART_SIZE=8388608

# --- Vault（与 .env.dev 相同）---
AURACLAW_CREDENTIAL_VAULT_ADDR=http://10.244.16.132:8200
AURACLAW_CREDENTIAL_VAULT_TOKEN=root
AURACLAW_CREDENTIAL_VAULT_MOUNT=secret
AURACLAW_CREDENTIAL_EGRESS_ALLOWLIST=
TEST_VAULT_CREDENTIAL_REF=test/auraclaw-credentials
TEST_VAULT_CREDENTIAL_FIELD=password

# --- Database（与 Java Chaintower 同一金仓主机/账号；库用 AuraClaw 的 chaintower_agent）---
# Java 业务库是 chaintower_db（无 CREATE SCHEMA 权限）。
# 智能体表在 chaintower_agent（已有 session_core/control/hands 等 schema）。
# jdbc 主机: 10.244.72.1:54321  user=chaintower_admin
# 12 个入口共用 DB_* / resolved_database_url（postgresql+asyncpg，KingBase V9 兼容）。
AURACLAW_DB_DIALECT=postgres
KINGBASE_HOST=10.244.72.1
KINGBASE_PORT=54321
KINGBASE_DB_USER=chaintower_admin
KINGBASE_DB_PWD=Chain@2026
KINGBASE_AURACLAW_DB=chaintower_agent
DB_HOST=10.244.72.1
DB_PORT=54321
DB_USER=chaintower_admin
DB_PWD=Chain@2026
DB_NAME=chaintower_agent
AURACLAW_DATABASE_URL=postgresql+asyncpg://chaintower_admin:Chain%402026@10.244.72.1:54321/chaintower_agent
AURACLAW_MIGRATION_DATABASE_URL=postgresql+asyncpg://chaintower_admin:Chain%402026@10.244.72.1:54321/chaintower_agent

# --- Model Skill / Price Insight ---
# 业务库已在金仓；Python 价格洞察适配器目前只支持 MySQL，本地改走 fixture。
# 智问价格工具仍走 Java MCP（同一金仓 chaintower_db）。
AURACLAW_MODEL_SKILL_SOURCE_ENABLED=false
AURACLAW_MODEL_SKILL_SOURCE_TENANT_ID=1
AURACLAW_MODEL_SKILL_TARGET_TENANT_ID=development
AURACLAW_MODEL_SKILL_INCLUDE_DRAFTS=false
AURACLAW_MODEL_SKILL_RECONCILE_INTERVAL_SECONDS=60
AURACLAW_PRICE_INSIGHT_SOURCE=fixture
AURACLAW_PRICE_INSIGHT_TARGET_TENANT_ID=development
AURACLAW_PRICE_INSIGHT_EXTRA_TENANT_IDS=local-org

# 访问 10.244.* 时绕过本机 HTTP 代理
NO_PROXY=10.244.16.131,10.244.16.132,10.244.16.133,10.244.16.134,10.244.72.1,127.0.0.1,localhost
no_proxy=10.244.16.131,10.244.16.132,10.244.16.133,10.244.16.134,10.244.72.1,127.0.0.1,localhost

# --- Redis（与 .env.dev 相同）---
REDIS_HOST=10.244.16.134
REDIS_PORT=6379
REDIS_DB=0
REDIS_PWD=Nxjc#113.com

