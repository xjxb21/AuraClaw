{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AuraClaw serve",
      "type": "debugpy",
      "request": "launch",
      "module": "auraclaw",
      "args": ["serve", "--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env.debug.example",
      "env": {
        "AURACLAW_ENV_FILE": "${workspaceFolder}/.env.debug.example",
        "AURACLAW_RUNTIME_ROLE": "agent"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "AuraMCP run",
      "type": "debugpy",
      "request": "launch",
      "module": "auramcp",
      "args": ["run", "--host", "127.0.0.1", "--port", "8020"],
      "cwd": "${workspaceFolder}/../AuraMCP",
      "python": "${workspaceFolder}/../AuraMCP/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/../AuraMCP/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "AuraClaw + AuraMCP",
      "configurations": ["AuraClaw serve", "AuraMCP run"],
      "stopAll": true
    }
  ]
}
