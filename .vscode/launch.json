  "version": "0.2.0",
  "configurations": [
    {
      "name": "AuraClaw: serve (local)",
      "type": "debugpy",
      "request": "launch",
      "module": "auraclaw",
      "args": ["serve", "--host", "127.0.0.1"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "osx": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "linux": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "envFile": "${workspaceFolder}/.env.debug",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONUNBUFFERED": "1",
        "AURACLAW_ENV_FILE": ".env.debug"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": { "group": "auraclaw", "order": 0 }
    },
